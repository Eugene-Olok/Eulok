---
import { getPageSEO } from '../seo/seoConfig.ts';
import { buildSEOTags } from '../seo/seoManager.ts';
import { siteConfig, isLoopbackOrigin, resolveSiteBaseUrl } from '../siteConfig.ts';
import { Navbar } from '../components/Navbar.tsx';
import { Footer } from '../components/Footer.tsx';
import { FloatingWhatsApp } from '../components/FloatingWhatsApp.tsx';
import { IntakeModalWrapper } from '../components/IntakeModalWrapper.tsx';
import { CommandPalette } from '../components/CommandPalette.tsx';
import { ClientRouter } from 'astro:transitions';
import '../index.css';

interface Props {
  pageId?: string;
  customTitle?: string;
  customDescription?: string;
}

const { pageId = 'home', customTitle, customDescription } = Astro.props;

const config = getPageSEO(pageId);
if (customTitle) config.title = customTitle;
if (customDescription) config.description = customDescription;

// Derive active origin from Astro.url, supporting preview/production hosts and falling back to siteConfig
const originHost = Astro.url?.origin;
const activeOrigin =
  originHost && !isLoopbackOrigin(originHost)
    ? resolveSiteBaseUrl(originHost)
    : siteConfig.defaultBaseUrl;

const seoData = buildSEOTags(config, activeOrigin);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090E17" />
    <title>{seoData.title}</title>
    <link rel="canonical" id="eulok-canonical-link" href={seoData.canonicalUrl} />
    <link rel="manifest" href="/manifest.webmanifest" />

    {seoData.metaTags.map((tag) => (
      tag.attributeName === 'name' ? (
        <meta name={tag.attributeValue} content={tag.content} />
      ) : (
        <meta property={tag.attributeValue} content={tag.content} />
      )
    ))}

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23090E17'/><path d='M30 25h40v12H44v13h22v12H44v13h26v12H30z' fill='%23527CA3'/></svg>" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script id="eulok-seo-jsonld" type="application/ld+json" set:html={seoData.jsonLd} />
    <ClientRouter />

    <script src="/theme-init.js" is:inline></script>
    <script src="/sw-register.js" defer is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <Navbar client:load currentPage={pageId} />

    <main id="main" class="w-full">
      <slot />
    </main>

    <Footer client:load />
    <FloatingWhatsApp client:load />
    <IntakeModalWrapper client:load />
    <CommandPalette client:load />
  </body>
</html>
