[Unit]
# TEMPLATE — reference target for scripts/isolate-secrets.sh. NOT installed by
# the repository; installation requires root. See
# docs/runbooks/secrets-isolation.md.
#
# Socket-activated local credential broker. There is no TCP listener: the broker
# is reachable only over this AF_UNIX socket.
Description=Company OS credential broker socket
Documentation=file:///home/genie/company/docs/runbooks/secrets-isolation.md
PartOf=company-os-credentials.service

[Socket]
ListenStream=/run/company-os/cred-broker.sock
# 0660 + group genie: the agent identity can connect; the broker additionally
# authorizes each connection by kernel-reported peer uid (SO_PEERCRED).
SocketMode=0660
SocketUser=root
SocketGroup=genie
DirectoryMode=0755
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
