[Unit]
# TEMPLATE — reference target for scripts/isolate-secrets.sh. NOT installed by
# the repository; installation requires root. See
# docs/runbooks/secrets-isolation.md.
#
# The credential broker is the single trusted reader of the protected secrets
# file. It runs as root so PID 1 can hand it a private copy of the file via
# LoadCredential= (the on-disk file stays root:root 0600), then maps each
# sandboxed run back to the calling peer's uid/gid. Callers receive command
# output only — never credential values.
Description=Company OS credential broker
Requires=company-os-credentials.socket
After=company-os-credentials.socket

[Service]
Type=simple
User=root
Group=root
# PID 1 reads the protected source file; the broker receives it at
# $CREDENTIALS_DIRECTORY/providers.env and the on-disk path is never touched by
# the broker's callers.
LoadCredential=providers.env:/home/genie/company-os/secrets/providers.env
Environment=COMPANY_OS_CRED_BROKER_ALLOWED_UIDS=1000
Environment=COMPANY_OS_CRED_BROKER_SOCKET=/run/company-os/cred-broker.sock
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/genie/company/tools/secrets/cred_broker.py serve --socket /run/company-os/cred-broker.sock
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077

# Hardening. The broker needs only: to read its credential copy, to run
# bubblewrap for the sandboxed child, and the AF_UNIX socket. It binds no
# network socket itself. NoNewPrivileges is intentionally OMITTED: the broker
# uses bubblewrap's user-namespace mapping to drop the child to the caller's
# uid, and NNP would prevent that on some kernels. Full hardening must be
# validated on the host before production activation (see the runbook).
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/company-os
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_DAC_READ_SEARCH CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_MKNOD CAP_KILL CAP_SYS_CHROOT CAP_NET_ADMIN
# AF_UNIX is for the broker's own listener and systemd's activation channel.
# AF_INET/AF_INET6/AF_NETLINK are REQUIRED by the sandboxed child: a network
# category (langfuse, cloudflare, posthog, ...) opens an outbound socket and
# resolves DNS inside the bwrap sandbox. Restricting this to AF_UNIX alone would
# make every credentialed network call fail at socket() with EAFNOSUPPORT, even
# though the sandbox itself is what enforces per-run isolation (--unshare-net
# for non-network categories). Do not narrow this back to AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
